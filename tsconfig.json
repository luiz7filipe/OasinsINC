{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "db/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts",
    "drizzle.config.ts",
    "client/**/*.ts",
    "shared/**/*.ts"
  ]
}
