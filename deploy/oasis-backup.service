# Example only: adapt user, paths, environment file, and resource limits.
[Unit]
Description=Oasis consistent database backup

[Service]
Type=oneshot
ExecStart=/opt/oasinsinc/runtime/bin/node /opt/oasinsinc/current/deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/oasinsinc
MemoryMax=256M
CPUQuota=25%
