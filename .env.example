# Exemplo: nenhum segredo real. npm run setup:local gera .dev.vars para uso local.
APP_ORIGIN=http://localhost:4173
APP_ENV=development
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
EMAIL_ENABLED=false
EMAIL_FROM=Oasis <conta@example.com>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=http://localhost:4173

# Apenas para a execução Node/VPS, com segredos próprios e HTTPS em produção.
DATABASE_PATH=./.data/oasis.sqlite
PORT=4187
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
